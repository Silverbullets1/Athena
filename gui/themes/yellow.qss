/* yellow.qss — Athena yellow-on-charcoal Qt stylesheet
 *
 * Color tokens:
 *   primary    #FACC15  (Tailwind yellow-400)
 *   accent     #EAB308  (yellow-500)
 *   warn       #CA8A04  (yellow-600)
 *   background #1F1F1F  (charcoal)
 *   surface    #2A2A2A  (charcoal lighter)
 *   text       #FAFAFA
 *   text-dim   #A3A3A3
 *   border     #3F3F3F
 *   success    #22C55E
 *   error      #EF4444
 */

QMainWindow {
    background-color: #1F1F1F;
    color: #FAFAFA;
}

QFrame#header {
    background-color: #FACC15;
    color: #1F1F1F;
    padding: 8px 16px;
    border-bottom: 2px solid #EAB308;
}

QFrame#header QLabel {
    color: #1F1F1F;
}

QWidget {
    color: #FAFAFA;
    background-color: #1F1F1F;
}

QFrame {
    background-color: #1F1F1F;
    border: 1px solid #3F3F3F;
}

QFrame QFrame {
    background-color: #2A2A2A;
    border: none;
}

QPushButton {
    background-color: #FACC15;
    color: #1F1F1F;
    border: 1px solid #EAB308;
    border-radius: 4px;
    padding: 8px 16px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #EAB308;
}

QPushButton:pressed {
    background-color: #CA8A04;
}

QPushButton#destructive {
    background-color: #CA8A04;
    color: #FAFAFA;
}

QPushButton#destructive:hover {
    background-color: #EAB308;
    color: #1F1F1F;
}

QRadioButton {
    color: #FAFAFA;
    spacing: 8px;
    padding: 4px 0;
}

QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border: 2px solid #FACC15;
    border-radius: 7px;
    background-color: #2A2A2A;
}

QRadioButton::indicator:hover {
    border-color: #EAB308;
}

QRadioButton::indicator:checked {
    background-color: #FACC15;
}

QLabel {
    color: #FAFAFA;
    padding: 2px 0;
}

QPlainTextEdit#log {
    background-color: #0A0A0A;
    color: #A3A3A3;
    font-family: "SF Mono", "Menlo", "Consolas", monospace;
    font-size: 12px;
    border: 1px solid #3F3F3F;
    padding: 4px;
}

QStatusBar {
    background-color: #1F1F1F;
    color: #A3A3A3;
    border-top: 1px solid #3F3F3F;
}

QStatusBar QLabel {
    color: #A3A3A3;
    padding: 0 8px;
}

QMessageBox {
    background-color: #1F1F1F;
    color: #FAFAFA;
}

QMessageBox QPushButton {
    min-width: 80px;
}
